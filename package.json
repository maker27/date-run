{
  "name": "date-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.shared.json tsconfig.server.json tsconfig.client.json tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build:test-client && playwright test",
    "test:e2e:server": "tsx tests/fixtures/server-entry.ts",
    "build:test-client": "vite build --config vite.test.config.ts",
    "test:deploy": "vitest run --config vitest.deploy.config.ts",
    "test:load": "tsx tests/load/run.ts",
    "test:load:server": "tsx tests/load/server.ts",
    "test:watch": "vitest",
    "start": "node dist/server/index.js",
    "assets:build": "tsx scripts/assets-cli.ts build",
    "assets:check": "tsx scripts/assets-cli.ts check",
    "check:paths": "tsx scripts/check-paths.ts",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "assets:preview": "vite --config vite.assets.config.ts --host 0.0.0.0"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "preact": "10.29.8",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "jsdom": "27.4.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
